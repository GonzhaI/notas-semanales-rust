import { TextEdit, Button, ListView, CheckBox } from "std-widgets.slint";

export global AppTheme {
    in-out property <bool> claro: false;

    out property <color> bg:         claro ? #ffffff : #1e1e1e;
    out property <color> panel:      claro ? #f3f3f3 : #252526;
    out property <color> hover:      claro ? #e8e8e8 : #37373d;
    out property <color> text:       claro ? #1e1e1e : #d4d4d4;
    out property <color> text-muted: claro ? #6e6e6e : #9da3af;
    out property <color> accent1:    claro ? #0070c1 : #569cd6;
    out property <color> accent2:    claro ? #007d6e : #4ec9b0;
    out property <color> ok:         claro ? #1a6d2a : #6a9955;
    out property <color> border:     claro ? #d0d0d0 : #2d2d30;

    in property <string> font-ui: "Segoe UI Variable";
    in property <string> font-mono: "Cascadia Code";
}

export struct LineaNota {
    texto_crudo: string,
    texto_limpio: string,
    es_activa: bool,
    tipo_bloque: string,
}

export struct EntradaNota {
    nombre: string,
    resumen: string,
}

export struct DiaCal {
    numero: int,
    es-mes: bool,
    es-hoy: bool,
}

export struct FilaCal {
    num-semana: int,
    anio: int,
    es-activa: bool,
    tiene-nota: bool,
    lun: DiaCal,
    mar: DiaCal,
    mie: DiaCal,
    jue: DiaCal,
    vie: DiaCal,
    sab: DiaCal,
    dom: DiaCal,
}

export component AppWindow inherits Window {
    width: 1000px;
    height: 700px;
    title: "Notas Semanales Bóveda";
    background: AppTheme.bg;
    default-font-family: AppTheme.font-ui;

    in property <[EntradaNota]> lista-notas;
    in property <bool> puede-crear-nota: false;
    in property <[LineaNota]> lineas-documento;
    in property <string> nota-activa: "";

    callback nota-seleccionada(string);
    callback crear-nota();
    callback actualizar-linea(int, string);
    callback cambiar-foco(int);
    callback toggle-tarea(int, bool);
    callback insertar-linea(int, string);
    callback mover-foco(int);
    callback eliminar-linea(int);
    callback undo();
    callback redo();
    callback eliminar-nota(string);
    callback exportar-nota();
    callback buscar(string);
    callback mes-anterior();
    callback mes-siguiente();
    callback ir-a-semana(int, int);
    in property <[FilaCal]> semanas-cal;
    in-out property <string> mes-anio-cal: "";

    in-out property <bool> tema-claro: false;
    in-out property <string> texto-busqueda: "";
    in property <[string]> resumen-tareas;
    in-out property <bool> vista-resumen: false;

    forward-focus: atajo-global;
    atajo-global := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "z") {
                root.undo();
                accept
            } else if (event.modifiers.control && event.text == "y") {
                root.redo();
                accept
            } else {
                reject
            }
        }
    }

    HorizontalLayout {
        // --- PANEL LATERAL IZQUIERDO ---
        Rectangle {
            width: 250px;
            background: AppTheme.panel;

            VerticalLayout {
                padding: 15px;
                spacing: 15px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Bóveda";
                        font-size: 18px;
                        color: AppTheme.text;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: tema-btn.has-hover ? AppTheme.hover : transparent;
                        tema-btn := TouchArea {
                            clicked => { AppTheme.claro = !AppTheme.claro; }
                        }
                        // Sol: visible en modo oscuro (al hacer click pasa a claro)
                        if !AppTheme.claro: Path {
                            width: 16px;
                            height: 16px;
                            x: 8px;
                            y: 8px;
                            stroke: AppTheme.text-muted;
                            stroke-width: 1.2px;
                            fill: transparent;
                            commands: "M 8 4.5 A 3.5 3.5 0 1 0 8 11.5 A 3.5 3.5 0 1 0 8 4.5 M 8 0 L 8 2 M 8 14 L 8 16 M 0 8 L 2 8 M 14 8 L 16 8 M 2.1 2.1 L 3.5 3.5 M 12.5 12.5 L 13.9 13.9 M 13.9 2.1 L 12.5 3.5 M 3.5 12.5 L 2.1 13.9";
                        }
                        // Luna: visible en modo claro (al hacer click pasa a oscuro)
                        if AppTheme.claro: Path {
                            width: 16px;
                            height: 16px;
                            x: 8px;
                            y: 8px;
                            stroke: AppTheme.text-muted;
                            stroke-width: 1.2px;
                            fill: transparent;
                            commands: "M 14 8.53 A 6 6 0 1 1 7.47 2 A 4.67 4.67 0 0 0 14 8.53 Z";
                        }
                    }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    background: AppTheme.bg;

                    busqueda-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        color: AppTheme.text;
                        vertical-alignment: center;
                        font-size: 13px;

                        edited => {
                            root.buscar(self.text);
                        }
                    }
                    Text {
                        visible: busqueda-input.text == "";
                        text: "Buscar notas...";
                        x: 8px;
                        color: AppTheme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "+ Crear";
                        height: 30px;
                        enabled: root.puede-crear-nota;
                        clicked => {
                            root.crear-nota();
                        }
                    }
                    Button {
                        text: "Exportar";
                        height: 30px;
                        enabled: root.nota-activa != "" && !root.vista-resumen;
                        clicked => {
                            root.exportar-nota();
                        }
                    }
                }

                Button {
                    text: root.vista-resumen ? "< Notas" : "Resumen >";
                    height: 30px;
                    clicked => {
                        root.vista-resumen = !root.vista-resumen;
                    }
                }

                ListView {
                    for entrada in lista-notas: Rectangle {
                        height: 48px;
                        border-radius: 5px;
                        background: root.nota-activa == entrada.nombre ? AppTheme.hover : (touch-nota.has-hover ? AppTheme.hover : transparent);

                        touch-nota := TouchArea {
                            clicked => {
                                root.nota-seleccionada(entrada.nombre);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: entrada.nombre;
                                    color: AppTheme.text;
                                    font-size: 13px;
                                    font-family: AppTheme.font-mono;
                                }
                                Text {
                                    text: entrada.resumen;
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                }
                            }

                            if touch-nota.has-hover || root.nota-activa == entrada.nombre: Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: btn-del.has-hover ? #c0392b : transparent;

                                btn-del := TouchArea {
                                    clicked => {
                                        root.eliminar-nota(entrada.nombre);
                                    }
                                }
                                Path {
                                    width: 10px;
                                    height: 10px;
                                    x: 9px;
                                    y: 9px;
                                    stroke: btn-del.has-hover ? #ffffff : AppTheme.text-muted;
                                    stroke-width: 1.5px;
                                    fill: transparent;
                                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                                }
                            }
                        }
                    }
                }

                // --- CALENDARIO ---
                Rectangle {
                    height: 185px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    background: AppTheme.bg;
                    clip: true;

                    VerticalLayout {
                        padding: 5px;
                        spacing: 2px;

                        HorizontalLayout {
                            height: 22px;
                            alignment: space-between;

                            Rectangle {
                                width: 22px; height: 22px; border-radius: 4px;
                                background: cal-prev.has-hover ? AppTheme.hover : transparent;
                                cal-prev := TouchArea { clicked => { root.mes-anterior(); } }
                                Path {
                                    width: 6px; height: 10px; x: 8px; y: 6px;
                                    stroke: AppTheme.text-muted; stroke-width: 1.5px; fill: transparent;
                                    commands: "M 6 0 L 0 5 L 6 10";
                                }
                            }

                            Text {
                                text: root.mes-anio-cal;
                                font-size: 12px; font-weight: 600;
                                color: AppTheme.text;
                                horizontal-alignment: center; vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px; height: 22px; border-radius: 4px;
                                background: cal-next.has-hover ? AppTheme.hover : transparent;
                                cal-next := TouchArea { clicked => { root.mes-siguiente(); } }
                                Path {
                                    width: 6px; height: 10px; x: 8px; y: 6px;
                                    stroke: AppTheme.text-muted; stroke-width: 1.5px; fill: transparent;
                                    commands: "M 0 0 L 6 5 L 0 10";
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 16px; spacing: 0px;
                            Rectangle { width: 24px; }
                            Text { horizontal-stretch: 1; text: "L"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "M"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "X"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "J"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "V"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "S"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: "D"; font-size: 10px; color: AppTheme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }

                        for fila in root.semanas-cal: HorizontalLayout {
                            height: 20px; spacing: 0px;

                            Rectangle {
                                width: 24px; height: 20px; border-radius: 3px;
                                background: cal-wk.has-hover ? AppTheme.hover : fila.es-activa ? AppTheme.accent1 : transparent;
                                cal-wk := TouchArea {
                                    clicked => { root.ir-a-semana(fila.num-semana, fila.anio); }
                                }
                                Text {
                                    text: "\{fila.num-semana}"; font-size: 9px;
                                    color: fila.es-activa ? AppTheme.bg : fila.tiene-nota ? AppTheme.accent1 : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.lun.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.lun.numero}"; font-size: 11px;
                                    color: fila.lun.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.lun.es-mes) ? AppTheme.accent2 : fila.lun.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.mar.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.mar.numero}"; font-size: 11px;
                                    color: fila.mar.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.mar.es-mes) ? AppTheme.accent2 : fila.mar.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.mie.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.mie.numero}"; font-size: 11px;
                                    color: fila.mie.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.mie.es-mes) ? AppTheme.accent2 : fila.mie.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.jue.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.jue.numero}"; font-size: 11px;
                                    color: fila.jue.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.jue.es-mes) ? AppTheme.accent2 : fila.jue.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.vie.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.vie.numero}"; font-size: 11px;
                                    color: fila.vie.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.vie.es-mes) ? AppTheme.accent2 : fila.vie.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.sab.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.sab.numero}"; font-size: 11px;
                                    color: fila.sab.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.sab.es-mes) ? AppTheme.accent2 : fila.sab.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 20px; border-radius: 3px;
                                background: fila.dom.es-hoy ? AppTheme.accent1 : transparent;
                                Text { text: "\{fila.dom.numero}"; font-size: 11px;
                                    color: fila.dom.es-hoy ? AppTheme.bg : (fila.tiene-nota && fila.dom.es-mes) ? AppTheme.accent2 : fila.dom.es-mes ? AppTheme.text : AppTheme.text-muted;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // --- EDITOR PRINCIPAL (Live Preview) ---
        Rectangle {
            background: AppTheme.bg;

            if root.vista-resumen: VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 20px;
                padding-bottom: 15px;
                spacing: 12px;

                Text {
                    text: "Tareas pendientes";
                    font-size: 22px;
                    font-weight: 700;
                    color: AppTheme.text;
                }

                Text {
                    visible: resumen-tareas.length == 0;
                    text: "Sin tareas pendientes en semanas anteriores.";
                    font-size: 14px;
                    color: AppTheme.text-muted;
                }

                ListView {
                    for tarea in resumen-tareas: Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: AppTheme.accent1;
                                y: 12px;
                            }
                            Text {
                                text: tarea;
                                color: AppTheme.text;
                                font-size: 14px;
                                font-family: AppTheme.font-mono;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if !root.vista-resumen && root.nota-activa == "": VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 40px;

                Text {
                    text: "Bienvenido";
                    font-size: 28px;
                    font-weight: 700;
                    color: AppTheme.text;
                }

                Text {
                    text: "Selecciona una nota semanal a la izquierda, o crea la de la semana cuando corresponda.";
                    font-size: 14px;
                    color: AppTheme.text-muted;
                    wrap: word-wrap;
                }
            }

            if !root.vista-resumen && root.nota-activa != "": VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-top: 15px;
                padding-bottom: 15px;
                ListView {
                    for linea[indice] in lineas-documento: Rectangle {
                        height: linea.tipo_bloque == "titulo1" ? 45px : linea.tipo_bloque == "titulo2" ? 38px : linea.tipo_bloque == "titulo3" ? 33px : 30px;

                        // MODO EDICIÓN
                        if linea.es_activa: TextInput {
                            width: 100%;
                            height: 100%;
                            color: AppTheme.text;
                            text: linea.texto_crudo;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            font-family: AppTheme.font-mono;
                            font-size: linea.tipo_bloque == "titulo1" ? 24px : linea.tipo_bloque == "titulo2" ? 20px : linea.tipo_bloque == "titulo3" ? 17px : 16px;

                            init => {
                                self.focus();
                            }

                            edited => {
                                root.actualizar-linea(indice, self.text);
                            }
                            accepted => {
                                root.insertar-linea(indice, self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.UpArrow) {
                                    root.mover-foco(-1);
                                    accept
                                } else if (event.text == Key.DownArrow) {
                                    root.mover-foco(1);
                                    accept
                                } else if (event.text == Key.Backspace && self.text == "") {
                                    root.eliminar-linea(indice);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        // MODO LECTURA
                        if !linea.es_activa: Rectangle {
                            TouchArea {
                                clicked => {
                                    root.cambiar-foco(indice);
                                }
                            }

                            HorizontalLayout {
                                alignment: start;

                                if linea.tipo_bloque == "titulo1": Text {
                                    text: linea.texto_limpio;
                                    font-size: 24px;
                                    font-weight: 700;
                                    color: AppTheme.accent1;
                                    vertical-alignment: center;
                                }

                                if linea.tipo_bloque == "titulo2": Text {
                                    text: linea.texto_limpio;
                                    font-size: 20px;
                                    font-weight: 600;
                                    color: AppTheme.accent2;
                                    vertical-alignment: center;
                                }

                                if linea.tipo_bloque == "titulo3": Text {
                                    text: linea.texto_limpio;
                                    font-size: 17px;
                                    font-weight: 600;
                                    color: AppTheme.text-muted;
                                    vertical-alignment: center;
                                }

                                if linea.tipo_bloque == "tarea_pendiente": HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    CheckBox {
                                        checked: false;
                                        toggled => {
                                            root.toggle-tarea(indice, self.checked);
                                        }
                                    }

                                    Text {
                                        text: linea.texto_limpio;
                                        color: AppTheme.text;
                                        vertical-alignment: center;
                                        font-size: 16px;
                                        font-family: AppTheme.font-mono;
                                    }
                                }

                                if linea.tipo_bloque == "tarea_completada": HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    CheckBox {
                                        checked: true;
                                        toggled => {
                                            root.toggle-tarea(indice, self.checked);
                                        }
                                    }

                                    Text {
                                        text: linea.texto_limpio;
                                        color: AppTheme.ok;
                                        vertical-alignment: center;
                                        font-size: 16px;
                                        font-family: AppTheme.font-mono;
                                    }
                                }

                                if linea.tipo_bloque == "vinieta": HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: AppTheme.text;
                                        y: 12px;
                                    }

                                    Text {
                                        text: linea.texto_limpio;
                                        color: AppTheme.text;
                                        vertical-alignment: center;
                                        font-size: 16px;
                                        font-family: AppTheme.font-mono;
                                    }
                                }

                                if linea.tipo_bloque == "parrafo": Text {
                                    text: linea.texto_crudo;
                                    color: AppTheme.text;
                                    vertical-alignment: center;
                                    font-size: 16px;
                                    font-family: AppTheme.font-mono;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
